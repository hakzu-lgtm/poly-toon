{
  "name": "웹툰 메이커",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y fonts-nanum && pip install -r requirements.txt",
  "postAttachCommand": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8000",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "웹툰 메이커",
      "onAutoForward": "openBrowser"
    }
  }
}
